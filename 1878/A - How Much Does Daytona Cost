#include <iostream>
#include <algorithm>
using namespace std;
string check(int arr[],int n,int k){
    int low=0;
    int high=n-1;
    while(low<=high){
        int mid=(high+low)/2;
        if(arr[mid]==k){
            return "YES";
        }
        else if(arr[mid]<k){
            low=mid+1;
        }
        else{
            high=mid-1;
        }
    }
    return "NO";
}
int main() {
    int t;
    cin>>t;
    while(t--){
        int n,k;
        cin>>n>>k;
        int arr[n];
        for(int i=0;i<n;i++){
            cin>>arr[i];
        }
        sort(arr,arr+n);
        cout<<check(arr,n,k)<<'
';
    }
 
    return 0;
}